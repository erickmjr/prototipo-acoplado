    "@aws-sdk/lib-dynamodb": "^3.700.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "aws-sdk-client-mock": "^4.1.0",
    "dependency-cruiser": "^16.8.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
