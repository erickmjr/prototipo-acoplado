{
  "name": "prototipo-acoplado",
  "version": "1.0.0",
  "private": true,
  "description": "Protótipo A — CRM de restaurantes com design acoplado (Fat Lambda)",
  "author": "Érick Mello Junior",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
